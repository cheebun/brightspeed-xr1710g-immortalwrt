 {
 	struct reset_control_bulk_data *xsi_rsts;
@@ -4163,6 +4250,25 @@ static int airoha_probe(struct platform_device *pdev)
 		return dev_err_probe(eth->dev, PTR_ERR(eth->fe_regs),
 				     "failed to iomap fe regs\n");
 
