 		airoha_fe_rmw(eth, REG_PPE_BIND_RATE(i),
 			      PPE_BIND_RATE_L2B_BIND_MASK |
 			      PPE_BIND_RATE_BIND_MASK,
-			      FIELD_PREP(PPE_BIND_RATE_L2B_BIND_MASK, 0x1e) |
-			      FIELD_PREP(PPE_BIND_RATE_BIND_MASK, 0x1e));
+			      FIELD_PREP(PPE_BIND_RATE_L2B_BIND_MASK, bind_rate) |
+			      FIELD_PREP(PPE_BIND_RATE_BIND_MASK, bind_rate));
 
 		airoha_fe_wr(eth, REG_PPE_HASH_SEED(i), PPE_HASH_SEED);
 		airoha_fe_clear(eth, REG_PPE_PPE_FLOW_CFG(i),
@@ -321,6 +373,15 @@ static int airoha_ppe_get_wdma_info(struct net_device *dev, const u8 *addr,
 	return 0;
 }
 
+static bool airoha_ppe_netdev_is_wlan(const struct net_device *netdev)
+{
+#if IS_ENABLED(CONFIG_CFG80211)
+	return netdev->ieee80211_ptr != NULL;
+#else
+	return false;
+#endif
+}
+
 static int airoha_get_dsa_port(struct net_device **dev)
 {
 #if IS_ENABLED(CONFIG_NET_DSA)
@@ -345,6 +406,102 @@ static void airoha_ppe_foe_set_bridge_addrs(struct airoha_foe_bridge *br,
 	br->src_mac_lo = get_unaligned_be32(eh->h_source + 2);
 }
 
+static u32
+airoha_ppe_pon_lookup_tag(const struct airoha_pon_flow_table *table,
+			  u16 vlan_id, u8 pbit)
+{
+	const struct airoha_pon_flow_entry *fallback = NULL;
+	unsigned int i;
+
+	for (i = 0; i < table->count; i++) {
+		const struct airoha_pon_flow_entry *entry = &table->entries[i];
+
+		if (!(entry->pbit_mask & BIT(pbit)))
+			continue;
+		if (entry->vlan_id == vlan_id)
+			return entry->tag;
+		if (entry->vlan_id == AIROHA_PON_VID_ANY && !fallback)
+			fallback = entry;
+	}
+
+	return fallback ? fallback->tag : 0;
+}
+
+static int airoha_ppe_pon_select_flow(struct airoha_gdm_dev *dev,
+				      const struct airoha_flow_data *data,
+				      u32 *pon_tag)
+{
+	const struct airoha_pon_flow_table *table;
+	u32 tag, first_tag = 0;
+	u16 vlan_id;
+	u8 pbit;
+
+	lockdep_assert_held(&flow_offload_mutex);
+
+	/* EPON uses the fixed LLID channel configured by the line controller. */
+	tag = READ_ONCE(dev->pon_qdma_tag);
+	if (tag & AIROHA_PON_QDMA_VALID) {
+		*pon_tag = tag;
+		return 0;
+	}
+
+	table = rcu_dereference_protected(dev->pon_flow_table,
+					  lockdep_is_held(&flow_offload_mutex));
+	if (!table)
+		return -EOPNOTSUPP;
+
+	/* nf_flow_table orders VLAN_PUSH from the upper devices towards the
+	 * hardware, so hdr[0] is the outer service tag the PON MAC transmits.
+	 * Untagged packets use VID_ANY, matching ndo_start_xmit classification.
+	 */
+	vlan_id = data->vlan.num ? data->vlan.hdr[0].id : AIROHA_PON_VID_ANY;
+
+	/* VLAN_PUSH actions carry no PCP, so the PON MAC always emits P-bit 0
+	 * for an offloaded flow. Accept that exact mapping first: it is the
+	 * classification the line card will really apply. Requiring all eight
+	 * P-bits to share one GEM rejects perfectly valid VID mappings.
+	 */
+	tag = airoha_ppe_pon_lookup_tag(table, vlan_id, 0);
+	if (tag & AIROHA_PON_QDMA_VALID) {
+		*pon_tag = tag;
+		return 0;
+	}
+
+	if (!data->vlan.num)
+		return -EOPNOTSUPP;
+
+	/* Fallback: tagged flows whose P-bit 0 is unmapped are still safe to
+	 * offload when every P-bit resolves to the same T-CONT/GEM. Split
+	 * mappings stay on the software path, which selects the channel per
+	 * packet from the actual priority.
+	 */
+	for (pbit = 0; pbit < 8; pbit++) {
+		tag = airoha_ppe_pon_lookup_tag(table, vlan_id, pbit);
+		if (!(tag & AIROHA_PON_QDMA_VALID))
+			return -EOPNOTSUPP;
+		tag &= AIROHA_PON_QDMA_VALID | AIROHA_PON_QDMA_EPON |
+		       AIROHA_PON_QDMA_TCONT_MASK | AIROHA_PON_QDMA_GEM_MASK;
+		if (!pbit)
+			first_tag = tag;
+		else if (tag != first_tag)
+			return -EOPNOTSUPP;
+	}
+
+	*pon_tag = first_tag;
+	return 0;
+}
+
+/* IB1 VPM selects the TPID used for the outer tag the PPE inserts:
+ * 1 -> 0x8100, 2 -> 0x88a8.
+ */
+static u32 airoha_ppe_vpm(const struct airoha_flow_data *data)
+{
+	if (!data->vlan.num)
+		return 0;
+
+	return data->vlan.hdr[0].proto == htons(ETH_P_8021AD) ? 2 : 1;
+}
+
 static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 					struct airoha_foe_entry *hwe,
 					struct net_device *netdev, int type,
@@ -362,7 +519,7 @@ static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 	      FIELD_PREP(AIROHA_FOE_IB1_BIND_PACKET_TYPE, type) |
 	      FIELD_PREP(AIROHA_FOE_IB1_BIND_UDP, l4proto == IPPROTO_UDP) |
 	      FIELD_PREP(AIROHA_FOE_IB1_BIND_VLAN_LAYER, data->vlan.num) |
-	      FIELD_PREP(AIROHA_FOE_IB1_BIND_VPM, data->vlan.num) |
+	      FIELD_PREP(AIROHA_FOE_IB1_BIND_VPM, airoha_ppe_vpm(data)) |
 	      FIELD_PREP(AIROHA_FOE_IB1_BIND_PPPOE, data->pppoe.num) |
 	      AIROHA_FOE_IB1_BIND_TTL;
 	hwe->ib1 = val;
@@ -834,6 +991,288 @@ static int airoha_ppe_foe_commit_entry(struct airoha_ppe *ppe,
 	return err;
 }
 
+#ifdef CONFIG_AIROHA_PON_COMPAT
+#include <linux/airoha_ppe_compat.h>
+extern struct airoha_eth *airoha_pon_compat_get_eth(void);
+
+static struct airoha_ppe *airoha_ppe_mc_instance(void)
+{
+	struct airoha_eth *eth = airoha_pon_compat_get_eth();
+
+	return eth ? READ_ONCE(eth->ppe) : NULL;
+}
+
+static void airoha_ppe_mc_group_mac(const struct airoha_ppe_mc_info *info,
+					    u8 *mac)
+{
+	memset(mac, 0, ETH_ALEN);
+
+	if (info->proto == AIROHA_PPE_MC_PROTO_IPV4) {
+		mac[0] = 0x01;
+		mac[1] = 0x00;
+		mac[2] = 0x5e;
+		mac[3] = info->grp_addr[1] & 0x7f;
+		mac[4] = info->grp_addr[2];
+		mac[5] = info->grp_addr[3];
+	} else if (info->proto == AIROHA_PPE_MC_PROTO_IPV6) {
+		mac[0] = 0x33;
+		mac[1] = 0x33;
+		memcpy(&mac[2], &info->grp_addr[12], 4);
+	}
+}
+
+/* AN7581 hardware-learned bridge entries use the native L2B layout, while
+ * CPU templates and DRAM copies keep the software bridge layout.
+ */
+static bool airoha_ppe_mc_uses_l2b(const struct airoha_ppe *ppe,
+				   const struct airoha_foe_entry *hwe)
+{
+	return airoha_is_7581(ppe->eth) &&
+	       FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) ==
+	       PPE_PKT_TYPE_BRIDGE;
+}
+
+static u32 airoha_ppe_mc_ib2(const struct airoha_foe_entry *hwe, bool l2b)
+{
+	return l2b ? hwe->l2b.ib2 : hwe->bridge.ib2;
+}
+
+static void airoha_ppe_mc_set_ib2(struct airoha_foe_entry *hwe, bool l2b,
+				  u32 ib2)
+{
+	if (l2b)
+		hwe->l2b.ib2 = ib2;
+	else
+		hwe->bridge.ib2 = ib2;
+}
+
+static u16 airoha_ppe_mc_vlan(const struct airoha_foe_entry *hwe, bool l2b,
+			      int index)
+{
+	if (l2b)
+		return index ? hwe->l2b.vlan2 : hwe->l2b.vlan1;
+
+	return index ? hwe->bridge.l2.common.vlan2 :
+		       hwe->bridge.l2.common.vlan1;
+}
+
+static void airoha_ppe_mc_dest_mac(const struct airoha_foe_entry *hwe, bool l2b,
+				   u8 *mac)
+{
+	u32 hi = l2b ? hwe->l2b.dest_mac_hi :
+		       hwe->bridge.l2.common.dest_mac_hi;
+	u16 lo = l2b ? hwe->l2b.dest_mac_lo :
+		       hwe->bridge.l2.common.dest_mac_lo;
+
+	put_unaligned_be32(hi, mac);
+	put_unaligned_be16(lo, mac + 4);
+}
+
+static bool airoha_ppe_mc_match(const struct airoha_ppe *ppe,
+				const struct airoha_foe_entry *hwe,
+				const struct airoha_ppe_mc_info *info)
+{
+	u8 mac[ETH_ALEN], entry_mac[ETH_ALEN];
+	u16 outer, inner, vlan1, vlan2;
+	bool l2b;
+
+	if (FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) !=
+	    PPE_PKT_TYPE_BRIDGE)
+		return false;
+
+	l2b = airoha_ppe_mc_uses_l2b(ppe, hwe);
+	if (!(airoha_ppe_mc_ib2(hwe, l2b) & AIROHA_FOE_IB2_MULTICAST))
+		return false;
+
+	airoha_ppe_mc_group_mac(info, mac);
+	airoha_ppe_mc_dest_mac(hwe, l2b, entry_mac);
+	if (!ether_addr_equal(mac, entry_mac))
+		return false;
+
+	vlan1 = airoha_ppe_mc_vlan(hwe, l2b, 0) & VLAN_VID_MASK;
+	vlan2 = airoha_ppe_mc_vlan(hwe, l2b, 1) & VLAN_VID_MASK;
+
+	/* Untagged video services carry no tag in the FOE even when the
+	 * bridge is VLAN aware, so such an entry always matches.
+	 */
+	if (!vlan1 && !vlan2)
+		return true;
+
+	if (!info->vlan_tag_num)
+		return false;
+
+	outer = info->outer_tci & VLAN_VID_MASK;
+	inner = info->inner_tci & VLAN_VID_MASK;
+	if (inner)
+		return vlan1 == outer && vlan2 == inner;
+
+	return vlan1 == outer || vlan2 == outer;
+}
+
+static struct airoha_foe_entry *
+airoha_ppe_mc_find_locked(struct airoha_ppe *ppe,
+				  const struct airoha_ppe_mc_info *info,
+				  u32 foe_index, u32 *hash)
+{
+	u32 total = airoha_ppe_get_total_num_entries(ppe);
+	u32 i;
+
+	if (foe_index < total) {
+		struct airoha_foe_entry *hwe;
+
+		hwe = airoha_ppe_foe_get_entry_locked(ppe, foe_index);
+		if (hwe && airoha_ppe_mc_match(ppe, hwe, info)) {
+			*hash = foe_index;
+			return hwe;
+		}
+	}
+
+	for (i = 0; i < total; i++) {
+		struct airoha_foe_entry *hwe;
+
+		if (i == foe_index)
+			continue;
+		hwe = airoha_ppe_foe_get_entry_locked(ppe, i);
+		if (hwe && airoha_ppe_mc_match(ppe, hwe, info)) {
+			*hash = i;
+			return hwe;
+		}
+	}
+
+	return NULL;
+}
+
+static int airoha_ppe_mc_apply(struct airoha_ppe *ppe,
+				 struct airoha_foe_entry *hwe, u32 hash,
+				 u32 port_mask)
+{
+	bool l2b = airoha_ppe_mc_uses_l2b(ppe, hwe);
+	u32 ib2;
+	int err;
+
+	/* SDK bits 0-3 are the only unambiguous EN7581 LAN mapping. */
+	if (port_mask & ~0x0fU)
+		return -EOPNOTSUPP;
+
+	ib2 = airoha_ppe_mc_ib2(hwe, l2b) & ~AIROHA_FOE_IB2_PORT_AG;
+	ib2 |= FIELD_PREP(AIROHA_FOE_IB2_PORT_AG, port_mask);
+	airoha_ppe_mc_set_ib2(hwe, l2b, ib2);
+	err = airoha_ppe_foe_commit_entry(ppe, hwe, hash, false);
+
+	return err;
+}
+
+int airoha_ppe_mc_update(const struct airoha_ppe_mc_info *info,
+			 u32 update_mode, u32 op_type, u32 port_mask, u32 local)
+{
+	struct airoha_ppe *ppe;
+	struct airoha_foe_entry *hwe;
+	u32 hash;
+	int err;
+
+	if (!info || (info->proto != AIROHA_PPE_MC_PROTO_IPV4 &&
+		      info->proto != AIROHA_PPE_MC_PROTO_IPV6))
+		return -EINVAL;
+	if (update_mode & (AIROHA_PPE_MC_UPDATE_VLAN |
+			   AIROHA_PPE_MC_UPDATE_SRCIP))
+		return -EOPNOTSUPP;
+	if (op_type != 0 || local)
+		return -EOPNOTSUPP;
+
+	ppe = airoha_ppe_mc_instance();
+	if (!ppe)
+		return -ENODEV;
+
+	spin_lock_bh(&ppe_lock);
+	hwe = airoha_ppe_mc_find_locked(ppe, info, 0xffff, &hash);
+	if (!hwe)
+		err = -ENOENT;
+	else if (!port_mask)
+		err = -ENOENT;
+	else
+		err = airoha_ppe_mc_apply(ppe, hwe, hash, port_mask);
+	spin_unlock_bh(&ppe_lock);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_ppe_mc_update);
+
+int airoha_ppe_mc_clear(void)
+{
+	struct airoha_ppe *ppe = airoha_ppe_mc_instance();
+	u32 total, sram, i;
+
+	if (!ppe)
+		return -ENODEV;
+
+	total = airoha_ppe_get_total_num_entries(ppe);
+	sram = airoha_ppe_get_total_sram_num_entries(ppe);
+	spin_lock_bh(&ppe_lock);
+	for (i = 0; i < total; i++) {
+		struct airoha_foe_entry *hwe;
+
+		hwe = airoha_ppe_foe_get_entry_locked(ppe, i);
+		if (!hwe ||
