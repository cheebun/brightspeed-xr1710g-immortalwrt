 			      PPE_DRAM_TB_NUM_ENTRY_MASK |
 			      PPE_TB_CFG_KEEPALIVE_MASK |
 			      PPE_TB_ENTRY_SIZE_MASK,
+			      PPE_TB_CFG_AGE_PREBIND_MASK |
+			      PPE_TB_CFG_AGE_NON_L4_MASK |
+			      PPE_TB_CFG_AGE_UNBIND_MASK |
+			      PPE_TB_CFG_AGE_TCP_MASK |
+			      PPE_TB_CFG_AGE_UDP_MASK |
+			      PPE_TB_CFG_AGE_TCP_FIN_MASK |
+			      FIELD_PREP(PPE_TB_CFG_SCAN_MODE_MASK,
+					 PPE_SCAN_MODE_CHECK_AGE) |
 			      FIELD_PREP(PPE_TB_CFG_SEARCH_MISS_MASK, 3) |
 			      FIELD_PREP(PPE_TB_ENTRY_SIZE_MASK, 0) |
 			      FIELD_PREP(PPE_SRAM_TB_NUM_ENTRY_MASK,
@@ -195,11 +230,28 @@ static void airoha_ppe_hw_init(struct airoha_ppe *ppe)
 			      FIELD_PREP(PPE_DRAM_TB_NUM_ENTRY_MASK,
 					 dram_num_entries));
 
+		/* Keep bind slots at their maximum so a bound flow is not
+		 * evicted before the aging timer retires it.
