+static int airoha_ppe_debugfs_summary_show(struct seq_file *m, void *private)
+{
+	static const char *const ppe_type_str[] = {
+		[PPE_PKT_TYPE_IPV4_HNAPT] = "IPv4 5T",
+		[PPE_PKT_TYPE_IPV4_ROUTE] = "IPv4 3T",
+		[PPE_PKT_TYPE_BRIDGE] = "L2B",
+		[PPE_PKT_TYPE_IPV4_DSLITE] = "DS-LITE",
+		[PPE_PKT_TYPE_IPV6_ROUTE_3T] = "IPv6 3T",
+		[PPE_PKT_TYPE_IPV6_ROUTE_5T] = "IPv6 5T",
+		[PPE_PKT_TYPE_IPV6_6RD] = "6RD",
+	};
+	static const char *const drop_str[__AIROHA_PPE_DROP_MAX] = {
+		[AIROHA_PPE_DROP_RULE_META] = "rule_meta",
+		[AIROHA_PPE_DROP_RULE_CONTROL] = "rule_control",
+		[AIROHA_PPE_DROP_RULE_BASIC] = "rule_basic",
+		[AIROHA_PPE_DROP_ADDR_TYPE] = "addr_type",
+		[AIROHA_PPE_DROP_ACTION] = "action",
+		[AIROHA_PPE_DROP_VLAN_ACTION] = "vlan_action",
+		[AIROHA_PPE_DROP_PPPOE_ACTION] = "pppoe_action",
+		[AIROHA_PPE_DROP_PORTS] = "ports",
+		[AIROHA_PPE_DROP_INVALID_MAC] = "invalid_mac",
+		[AIROHA_PPE_DROP_PON_MAPPING] = "pon_mapping",
+		[AIROHA_PPE_DROP_WDMA] = "wdma",
+	};
+	u64 entry_packets[ARRAY_SIZE(ppe_type_str)] = {};
+	u64 entry_bytes[ARRAY_SIZE(ppe_type_str)] = {};
+	u32 entry_total[ARRAY_SIZE(ppe_type_str)] = {};
+	u32 entry_bound[ARRAY_SIZE(ppe_type_str)] = {};
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_eth *eth = ppe->eth;
+	u32 total, i;
+
+	/* Hardware counters only exist when the flow stats region is
+	 * enabled; without it every packets/bytes value stays zero.
+	 */
+	total = airoha_ppe_get_total_num_entries(ppe);
+	for (i = 0; i < total; i++) {
+		struct airoha_foe_stats64 stats = {};
+		struct airoha_foe_entry *hwe;
+		u32 state, type;
+
+		hwe = airoha_ppe_foe_get_entry(ppe, i);
+		if (!hwe)
+			continue;
+
+		state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE,
+				  READ_ONCE(hwe->ib1));
+		if (state == AIROHA_FOE_STATE_INVALID)
+			continue;
+
+		type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE,
+				 READ_ONCE(hwe->ib1));
+		if (type >= ARRAY_SIZE(ppe_type_str) || !ppe_type_str[type])
+			continue;
+
+		entry_total[type]++;
+		if (state == AIROHA_FOE_STATE_BIND)
+			entry_bound[type]++;
+
+		airoha_ppe_foe_entry_get_stats(ppe, i, &stats);
+		entry_packets[type] += stats.packets;
+		entry_bytes[type] += stats.bytes;
+	}
+
+	seq_puts(m, "type      total bound packets bytes\n");
+	for (i = 0; i < ARRAY_SIZE(ppe_type_str); i++) {
+		if (!ppe_type_str[i])
+			continue;
+		seq_printf(m, "%-9s %5u %5u %llu %llu\n", ppe_type_str[i],
+			   entry_total[i], entry_bound[i],
+			   entry_packets[i], entry_bytes[i]);
+	}
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		seq_printf(m, "ppe%u bind_rate=%08x tb_cfg=%08x unbind_age=%08x bind_age0=%08x bind_age1=%08x\n",
+			   i, airoha_fe_rr(eth, REG_PPE_BIND_RATE(i)),
+			   airoha_fe_rr(eth, REG_PPE_TB_CFG(i)),
+			   airoha_fe_rr(eth, REG_PPE_UNBIND_AGE(i)),
+			   airoha_fe_rr(eth, REG_PPE_BND_AGE0(i)),
+			   airoha_fe_rr(eth, REG_PPE_BND_AGE1(i)));
+	}
+
+	seq_puts(m, "offload drops:\n");
+	for (i = 0; i < ARRAY_SIZE(drop_str); i++)
+		seq_printf(m, " %-13s %lld\n", drop_str[i],
+			   (long long)atomic64_read(&ppe->drop[i]));
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_summary);
+
+static int airoha_ppe_debugfs_bind_rate_show(struct seq_file *m, void *private)
+{
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_eth *eth = ppe->eth;
+	unsigned int i;
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		u32 rate = airoha_fe_rr(eth, REG_PPE_BIND_RATE(i));
+
+		seq_printf(m, "ppe%u: l2b=%u l3=%u\n", i,
+			   FIELD_GET(PPE_BIND_RATE_L2B_BIND_MASK, rate),
+			   FIELD_GET(PPE_BIND_RATE_BIND_MASK, rate));
+	}
+
+	return 0;
+}
+
+static int airoha_ppe_debugfs_bind_rate_open(struct inode *inode,
+					     struct file *file)
+{
+	return single_open(file, airoha_ppe_debugfs_bind_rate_show,
+			   inode->i_private);
+}
+
+static ssize_t
+airoha_ppe_debugfs_bind_rate_write(struct file *file, const char __user *user_buf,
+				   size_t count, loff_t *ppos)
+{
+	struct seq_file *m = file->private_data;
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_eth *eth = ppe->eth;
+	unsigned int l2b, l3, i;
+	char buf[32];
+	int ret;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, user_buf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	ret = sscanf(buf, "%u %u", &l2b, &l3);
+	if (ret == 1)
+		l3 = l2b;
+	else if (ret != 2)
+		return -EINVAL;
+	if (l2b > 0xffff || l3 > 0xffff)
+		return -ERANGE;
+
+	for (i = 0; i < eth->soc->num_ppe; i++)
+		airoha_fe_rmw(eth, REG_PPE_BIND_RATE(i),
+			      PPE_BIND_RATE_L2B_BIND_MASK |
+			      PPE_BIND_RATE_BIND_MASK,
+			      FIELD_PREP(PPE_BIND_RATE_L2B_BIND_MASK, l2b) |
+			      FIELD_PREP(PPE_BIND_RATE_BIND_MASK, l3));
+
+	return count;
+}
+
+static const struct file_operations airoha_ppe_debugfs_bind_rate_fops = {
+	.owner = THIS_MODULE,
+	.open = airoha_ppe_debugfs_bind_rate_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+	.write = airoha_ppe_debugfs_bind_rate_write,
+};
+
 int airoha_ppe_debugfs_init(struct airoha_ppe *ppe)
 {
 	ppe->debugfs_dir = debugfs_create_dir("ppe", NULL);
+	debugfs_create_file("config", 0444, ppe->debugfs_dir, ppe,
+			    &airoha_ppe_debugfs_config_fops);
+	debugfs_create_file("bind_rate", 0644, ppe->debugfs_dir, ppe,
+			    &airoha_ppe_debugfs_bind_rate_fops);
 	debugfs_create_file("entries", 0444, ppe->debugfs_dir, ppe,
 			    &airoha_ppe_debugfs_foe_all_fops);
 	debugfs_create_file("bind", 0444, ppe->debugfs_dir, ppe,
 			    &airoha_ppe_debugfs_foe_bind_fops);
+	debugfs_create_file("summary", 0444, ppe->debugfs_dir, ppe,
+			    &airoha_ppe_debugfs_summary_fops);
 
 	return 0;
 }
