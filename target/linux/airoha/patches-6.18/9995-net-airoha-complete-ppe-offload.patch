 	int i, sram_num_stats_entries;
@@ -182,12 +198,31 @@ static void airoha_ppe_hw_init(struct airoha_ppe *ppe)
 			      FIELD_PREP(PPE_SRAM_HASH1_MODE_MASK, 1) |
 			      FIELD_PREP(PPE_DRAM_HASH1_MODE_MASK, 3));
 
+		/* Without the AGE_* bits the PPE never expires entries and a
