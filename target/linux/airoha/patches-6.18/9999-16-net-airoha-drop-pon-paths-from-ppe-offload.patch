-
-static void airoha_ppe_mc_group_mac(const struct airoha_ppe_mc_info *info,
-					    u8 *mac)
-{
-	memset(mac, 0, ETH_ALEN);
-
-	if (info->proto == AIROHA_PPE_MC_PROTO_IPV4) {
-		mac[0] = 0x01;
-		mac[1] = 0x00;
-		mac[2] = 0x5e;
-		mac[3] = info->grp_addr[1] & 0x7f;
-		mac[4] = info->grp_addr[2];
-		mac[5] = info->grp_addr[3];
-	} else if (info->proto == AIROHA_PPE_MC_PROTO_IPV6) {
-		mac[0] = 0x33;
-		mac[1] = 0x33;
-		memcpy(&mac[2], &info->grp_addr[12], 4);
-	}
-}
-
-/* AN7581 hardware-learned bridge entries use the native L2B layout, while
- * CPU templates and DRAM copies keep the software bridge layout.
- */
-static bool airoha_ppe_mc_uses_l2b(const struct airoha_ppe *ppe,
-				   const struct airoha_foe_entry *hwe)
-{
-	return airoha_is_7581(ppe->eth) &&
-	       FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) ==
-	       PPE_PKT_TYPE_BRIDGE;
-}
-
-static u32 airoha_ppe_mc_ib2(const struct airoha_foe_entry *hwe, bool l2b)
-{
-	return l2b ? hwe->l2b.ib2 : hwe->bridge.ib2;
-}
-
-static void airoha_ppe_mc_set_ib2(struct airoha_foe_entry *hwe, bool l2b,
-				  u32 ib2)
-{
-	if (l2b)
-		hwe->l2b.ib2 = ib2;
-	else
-		hwe->bridge.ib2 = ib2;
-}
-
-static u16 airoha_ppe_mc_vlan(const struct airoha_foe_entry *hwe, bool l2b,
-			      int index)
-{
-	if (l2b)
-		return index ? hwe->l2b.vlan2 : hwe->l2b.vlan1;
-
-	return index ? hwe->bridge.l2.common.vlan2 :
-		       hwe->bridge.l2.common.vlan1;
-}
-
-static void airoha_ppe_mc_dest_mac(const struct airoha_foe_entry *hwe, bool l2b,
-				   u8 *mac)
-{
-	u32 hi = l2b ? hwe->l2b.dest_mac_hi :
-		       hwe->bridge.l2.common.dest_mac_hi;
-	u16 lo = l2b ? hwe->l2b.dest_mac_lo :
-		       hwe->bridge.l2.common.dest_mac_lo;
-
-	put_unaligned_be32(hi, mac);
-	put_unaligned_be16(lo, mac + 4);
-}
-
-static bool airoha_ppe_mc_match(const struct airoha_ppe *ppe,
-				const struct airoha_foe_entry *hwe,
-				const struct airoha_ppe_mc_info *info)
-{
-	u8 mac[ETH_ALEN], entry_mac[ETH_ALEN];
-	u16 outer, inner, vlan1, vlan2;
-	bool l2b;
-
-	if (FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) !=
-	    PPE_PKT_TYPE_BRIDGE)
-		return false;
-
-	l2b = airoha_ppe_mc_uses_l2b(ppe, hwe);
-	if (!(airoha_ppe_mc_ib2(hwe, l2b) & AIROHA_FOE_IB2_MULTICAST))
-		return false;
-
-	airoha_ppe_mc_group_mac(info, mac);
-	airoha_ppe_mc_dest_mac(hwe, l2b, entry_mac);
-	if (!ether_addr_equal(mac, entry_mac))
-		return false;
-
-	vlan1 = airoha_ppe_mc_vlan(hwe, l2b, 0) & VLAN_VID_MASK;
-	vlan2 = airoha_ppe_mc_vlan(hwe, l2b, 1) & VLAN_VID_MASK;
-
-	/* Untagged video services carry no tag in the FOE even when the
-	 * bridge is VLAN aware, so such an entry always matches.
-	 */
-	if (!vlan1 && !vlan2)
-		return true;
-
-	if (!info->vlan_tag_num)
-		return false;
-
-	outer = info->outer_tci & VLAN_VID_MASK;
-	inner = info->inner_tci & VLAN_VID_MASK;
-	if (inner)
-		return vlan1 == outer && vlan2 == inner;
-
-	return vlan1 == outer || vlan2 == outer;
-}
-
-static struct airoha_foe_entry *
-airoha_ppe_mc_find_locked(struct airoha_ppe *ppe,
-				  const struct airoha_ppe_mc_info *info,
-				  u32 foe_index, u32 *hash)
-{
-	u32 total = airoha_ppe_get_total_num_entries(ppe);
-	u32 i;
-
-	if (foe_index < total) {
-		struct airoha_foe_entry *hwe;
-
-		hwe = airoha_ppe_foe_get_entry_locked(ppe, foe_index);
-		if (hwe && airoha_ppe_mc_match(ppe, hwe, info)) {
-			*hash = foe_index;
-			return hwe;
-		}
-	}
-
-	for (i = 0; i < total; i++) {
-		struct airoha_foe_entry *hwe;
-
-		if (i == foe_index)
-			continue;
-		hwe = airoha_ppe_foe_get_entry_locked(ppe, i);
-		if (hwe && airoha_ppe_mc_match(ppe, hwe, info)) {
-			*hash = i;
-			return hwe;
-		}
-	}
-
-	return NULL;
-}
-
-static int airoha_ppe_mc_apply(struct airoha_ppe *ppe,
-				 struct airoha_foe_entry *hwe, u32 hash,
-				 u32 port_mask)
-{
-	bool l2b = airoha_ppe_mc_uses_l2b(ppe, hwe);
-	u32 ib2;
-	int err;
-
-	/* SDK bits 0-3 are the only unambiguous EN7581 LAN mapping. */
-	if (port_mask & ~0x0fU)
-		return -EOPNOTSUPP;
-
-	ib2 = airoha_ppe_mc_ib2(hwe, l2b) & ~AIROHA_FOE_IB2_PORT_AG;
-	ib2 |= FIELD_PREP(AIROHA_FOE_IB2_PORT_AG, port_mask);
-	airoha_ppe_mc_set_ib2(hwe, l2b, ib2);
-	err = airoha_ppe_foe_commit_entry(ppe, hwe, hash, false);
-
-	return err;
-}
-
-int airoha_ppe_mc_update(const struct airoha_ppe_mc_info *info,
-			 u32 update_mode, u32 op_type, u32 port_mask, u32 local)
-{
-	struct airoha_ppe *ppe;
-	struct airoha_foe_entry *hwe;
-	u32 hash;
-	int err;
-
-	if (!info || (info->proto != AIROHA_PPE_MC_PROTO_IPV4 &&
-		      info->proto != AIROHA_PPE_MC_PROTO_IPV6))
-		return -EINVAL;
-	if (update_mode & (AIROHA_PPE_MC_UPDATE_VLAN |
-			   AIROHA_PPE_MC_UPDATE_SRCIP))
-		return -EOPNOTSUPP;
-	if (op_type != 0 || local)
-		return -EOPNOTSUPP;
-
-	ppe = airoha_ppe_mc_instance();
-	if (!ppe)
-		return -ENODEV;
-
-	spin_lock_bh(&ppe_lock);
-	hwe = airoha_ppe_mc_find_locked(ppe, info, 0xffff, &hash);
-	if (!hwe)
-		err = -ENOENT;
-	else if (!port_mask)
-		err = -ENOENT;
-	else
-		err = airoha_ppe_mc_apply(ppe, hwe, hash, port_mask);
-	spin_unlock_bh(&ppe_lock);
-
-	return err;
-}
-EXPORT_SYMBOL_GPL(airoha_ppe_mc_update);
-
-int airoha_ppe_mc_clear(void)
-{
-	struct airoha_ppe *ppe = airoha_ppe_mc_instance();
-	u32 total, sram, i;
-
-	if (!ppe)
-		return -ENODEV;
-
-	total = airoha_ppe_get_total_num_entries(ppe);
-	sram = airoha_ppe_get_total_sram_num_entries(ppe);
-	spin_lock_bh(&ppe_lock);
-	for (i = 0; i < total; i++) {
-		struct airoha_foe_entry *hwe;
-
-		hwe = airoha_ppe_foe_get_entry_locked(ppe, i);
-		if (!hwe ||
-		    !(airoha_ppe_mc_ib2(hwe, airoha_ppe_mc_uses_l2b(ppe, hwe)) &
-		      AIROHA_FOE_IB2_MULTICAST))
-			continue;
-		hwe->ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
-		hwe->ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
-					AIROHA_FOE_STATE_INVALID);
-		if (i < sram)
-			airoha_ppe_foe_commit_sram_entry(ppe, i);
-	}
-	spin_unlock_bh(&ppe_lock);
-
-	return 0;
-}
-EXPORT_SYMBOL_GPL(airoha_ppe_mc_clear);
-
-int airoha_ppe_mc_get_portmask(const struct airoha_ppe_mc_info *info,
-			       u32 foe_index)
-{
-	struct airoha_ppe *ppe = airoha_ppe_mc_instance();
-	struct airoha_foe_entry *hwe;
-	u32 hash, port_mask;
-
-	if (!info)
-		return -EINVAL;
-
-	if (!ppe)
-		return -ENODEV;
-
-	spin_lock_bh(&ppe_lock);
-	hwe = airoha_ppe_mc_find_locked(ppe, info, foe_index, &hash);
-	port_mask = hwe ?
-		FIELD_GET(AIROHA_FOE_IB2_PORT_AG,
-			  airoha_ppe_mc_ib2(hwe, airoha_ppe_mc_uses_l2b(ppe, hwe))) :
-		0;
-	spin_unlock_bh(&ppe_lock);
-
-	return hwe ? (port_mask & 0x0f) : -ENOENT;
-}
