-static u32
-airoha_ppe_pon_lookup_tag(const struct airoha_pon_flow_table *table,
-			  u16 vlan_id, u8 pbit)
-{
-	const struct airoha_pon_flow_entry *fallback = NULL;
-	unsigned int i;
-
-	for (i = 0; i < table->count; i++) {
-		const struct airoha_pon_flow_entry *entry = &table->entries[i];
-
-		if (!(entry->pbit_mask & BIT(pbit)))
-			continue;
-		if (entry->vlan_id == vlan_id)
-			return entry->tag;
-		if (entry->vlan_id == AIROHA_PON_VID_ANY && !fallback)
-			fallback = entry;
-	}
-
-	return fallback ? fallback->tag : 0;
-}
-
-static int airoha_ppe_pon_select_flow(struct airoha_gdm_dev *dev,
-				      const struct airoha_flow_data *data,
-				      u32 *pon_tag)
-{
-	const struct airoha_pon_flow_table *table;
-	u32 tag, first_tag = 0;
-	u16 vlan_id;
-	u8 pbit;
-
-	lockdep_assert_held(&flow_offload_mutex);
-
-	/* EPON uses the fixed LLID channel configured by the line controller. */
-	tag = READ_ONCE(dev->pon_qdma_tag);
-	if (tag & AIROHA_PON_QDMA_VALID) {
-		*pon_tag = tag;
-		return 0;
-	}
-
-	table = rcu_dereference_protected(dev->pon_flow_table,
-					  lockdep_is_held(&flow_offload_mutex));
-	if (!table)
-		return -EOPNOTSUPP;
-
-	/* nf_flow_table orders VLAN_PUSH from the upper devices towards the
-	 * hardware, so hdr[0] is the outer service tag the PON MAC transmits.
-	 * Untagged packets use VID_ANY, matching ndo_start_xmit classification.
-	 */
-	vlan_id = data->vlan.num ? data->vlan.hdr[0].id : AIROHA_PON_VID_ANY;
-
-	/* VLAN_PUSH actions carry no PCP, so the PON MAC always emits P-bit 0
-	 * for an offloaded flow. Accept that exact mapping first: it is the
-	 * classification the line card will really apply. Requiring all eight
-	 * P-bits to share one GEM rejects perfectly valid VID mappings.
-	 */
-	tag = airoha_ppe_pon_lookup_tag(table, vlan_id, 0);
-	if (tag & AIROHA_PON_QDMA_VALID) {
-		*pon_tag = tag;
-		return 0;
-	}
-
-	if (!data->vlan.num)
-		return -EOPNOTSUPP;
-
-	/* Fallback: tagged flows whose P-bit 0 is unmapped are still safe to
-	 * offload when every P-bit resolves to the same T-CONT/GEM. Split
-	 * mappings stay on the software path, which selects the channel per
-	 * packet from the actual priority.
-	 */
-	for (pbit = 0; pbit < 8; pbit++) {
-		tag = airoha_ppe_pon_lookup_tag(table, vlan_id, pbit);
-		if (!(tag & AIROHA_PON_QDMA_VALID))
-			return -EOPNOTSUPP;
-		tag &= AIROHA_PON_QDMA_VALID | AIROHA_PON_QDMA_EPON |
-		       AIROHA_PON_QDMA_TCONT_MASK | AIROHA_PON_QDMA_GEM_MASK;
-		if (!pbit)
-			first_tag = tag;
-		else if (tag != first_tag)
-			return -EOPNOTSUPP;
-	}
-
-	*pon_tag = first_tag;
-	return 0;
-}
