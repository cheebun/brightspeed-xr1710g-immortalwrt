From: naoki66 <naoki66@qq.com>
Subject: [PATCH] dawn: 6 GHz band metrics

DAWN supports 6 GHz natively since 2026-11-10 (band DAWN_BAND_80211AX,
UCI section '802_11ax'), so the source patch that added a separate
'802_11a_6g' band is gone. Keep the XR1710G tuning by shipping the 6 GHz
metric section under the upstream name: same values as 802_11a
(initial_score 100 instead of the built-in 110).

---
diff --git a/net/dawn/files/dawn.config b/net/dawn/files/dawn.config
index 1154d2b1..b78ce9da 100644
--- a/net/dawn/files/dawn.config
+++ b/net/dawn/files/dawn.config
@@ -78,3 +78,20 @@ config metric '802_11a'
 	option max_chan_util_val '170'
 	option rssi_weight '0'
 	option rssi_center '-70'
+
+config metric '802_11ax'
+	option initial_score '100'
+	option ht_support '5'
+	option vht_support '5'
+	option no_ht_support '0'
+	option no_vht_support '0'
+	option rssi '15'
+	option rssi_val '-60'
+	option low_rssi_val '-80'
+	option low_rssi '-15'
+	option chan_util '0'
+	option chan_util_val '140'
+	option max_chan_util '-15'
+	option max_chan_util_val '170'
+	option rssi_weight '0'
+	option rssi_center '-70'
