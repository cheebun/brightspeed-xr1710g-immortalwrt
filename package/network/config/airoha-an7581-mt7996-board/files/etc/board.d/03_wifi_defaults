#!/bin/sh
#
# Copyright (C) 2026 ImmortalWrt
#
# WiFi SSID / encryption / country defaults for Gemtek XR1710G / W1700K.
# These are written into board.json and consumed by mac80211.uc during
# wireless config generation, so they take effect on first boot without
# fighting uci-defaults timing issues.

. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
gemtek,xr1710g|\
gemtek,xr1710g-ubi)
	ucidef_set_country 'US'
	ucidef_set_wireless 2g 'Brightspeed-XR1710G' 'psk2' 'password'
	ucidef_set_wireless 5g 'Brightspeed-XR1710G' 'sae-mixed' 'password'
	ucidef_set_wireless 6g 'Brightspeed-XR1710G' 'sae' 'password'
	;;
gemtek,w1700k-ubi)
	ucidef_set_country 'US'
	ucidef_set_wireless 2g 'OpenWRT' 'psk2' 'password'
	ucidef_set_wireless 5g 'OpenWRT' 'sae-mixed' 'password'
	ucidef_set_wireless 6g 'OpenWRT' 'sae' 'password'
	;;
esac

board_config_flush

exit 0
